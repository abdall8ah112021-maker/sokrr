# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FRONTEND API BASE URL (For Vercel / External Backend Deployments)
# When the frontend is hosted on Vercel and the backend is hosted on a separate server (e.g. Render, Railway, Fly.io, or VPS),
# set this variable in Vercel Project Settings > Environment Variables:
# Example: VITE_API_BASE_URL="https://sugar-business-backend.onrender.com"
VITE_API_BASE_URL=""

# ENVIRONMENT CONFIGURATION
NODE_ENV="development" # development | staging | production
PORT=3000

# DATABASE (PostgreSQL / Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/sugar_business?schema=public"

# REDIS (Cache & Queue)
REDIS_URL="redis://localhost:6379"

# AUTHENTICATION & SECURITY
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_ACCESS_SECRET_KEY_MIN_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_REFRESH_SECRET_KEY_MIN_32_CHARS"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CLOUD STORAGE (S3 / GCS Compatible Object Storage for Media)
STORAGE_ENDPOINT="https://storage.googleapis.com"
STORAGE_BUCKET_NAME="sugar-business-media"
STORAGE_ACCESS_KEY="CHANGE_ME_STORAGE_ACCESS_KEY"
STORAGE_SECRET_KEY="CHANGE_ME_STORAGE_SECRET_KEY"

# APPLICATION TIMEZONE & CURRENCY
APP_TIMEZONE="Africa/Cairo"
APP_CURRENCY="EGP"
